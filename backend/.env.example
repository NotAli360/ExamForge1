# Server
PORT=8001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Used only as an OpenRouter attribution header (HTTP-Referer) - not secret.
APP_URL=http://localhost:3000

# Mongo
MONGO_URL=mongodb://localhost:27017
DB_NAME=examforge

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# OpenRouter - THE ONLY AI PROVIDER
# ---------------------------------------------------------------------------
# SECRET. Server-side only. Never prefix this with REACT_APP_ / VITE_ /
# NEXT_PUBLIC_ - those get bundled into frontend JS and exposed to the
# browser. This variable is read exactly once, in backend/src/services/
# llm.service.js, and nowhere else in the codebase.
OPENROUTER_API_KEY=

# Rarely need to change these:
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
LLM_TIMEOUT_MS=45000

# Model roles - change the MODEL by editing these values, never by editing
# code. Fallback order for text generation is PRIMARY -> FAST -> BALANCED.
# Verify current availability at https://openrouter.ai/models before relying
# on any of these long-term; free-tier model slugs rotate.
PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FAST_MODEL=nvidia/nemotron-3.5-lightning:free
BALANCED_MODEL=google/gemma-4-26b-a4b-it:free
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Semantic retrieval is an enhancement; it falls back to lexical MongoDB retrieval if unavailable.
ENABLE_SEMANTIC_RETRIEVAL=true
